# Copy this file to ".env" and fill in your real Discord webhook URL.
#
# How to get a webhook URL:
#   Discord -> 編輯頻道 (Edit Channel) -> 整合 (Integrations) -> Webhook
#   -> 新增 Webhook (New Webhook) -> 複製 Webhook 網址 (Copy Webhook URL)
#
# Treat this URL like a password — anyone with it can post to your channel.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY

# Optional future channels (not used by default; leave blank):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
